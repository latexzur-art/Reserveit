# ==============================================
# ReserveIt Environment Configuration Template
# ==============================================
# Copy this file to .env.local and fill in values for your target environment.
# NEVER commit .env.local to version control.
#
# ENVIRONMENT GUIDE:
#   Local dev (feature branches) → use Local Supabase Docker values below
#   Dev branch (Vercel preview)  → set in Vercel Dashboard > Preview env vars
#   Production (main branch)     → set in Vercel Dashboard > Production env vars
#
# LOCAL DOCKER SETUP (for feature branch dev):
#   1. Run: npm run db:local:start
#   2. Copy the URL and keys from the output of: npm run db:local:status
#   3. Paste them below (anon key and service_role key are printed by supabase start)
#   Local URL:          http://localhost:54321
#   Local Studio:       http://localhost:54323
#   Local anon key:     printed by `supabase start` or `supabase status`
#   Local service key:  printed by `supabase start` or `supabase status`

# ==============================================
# SUPABASE CONFIGURATION
# ==============================================
# Local Docker:  NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# Dev DB:        NEXT_PUBLIC_SUPABASE_URL=https://nqoloqrldqgrbeeujkdw.supabase.co
# Prod DB:       NEXT_PUBLIC_SUPABASE_URL=https://aascxdiyetopvrxifape.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Anon/Public Key - Safe to use in client-side code
# New-format keys (sb_publishable_*) or JWT keys (eyJ*) are both supported.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key - ONLY use in backend/server-side code
# WARNING: Has full database access - keep this secret!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==============================================
# DATABASE (For direct connections if needed)
# ==============================================
# Get these from: Supabase Dashboard > Project Settings > Database
# Usually not needed if using Supabase client

# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# ==============================================
# APPLICATION CONFIGURATION
# ==============================================
# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS and absolute URL generation)
# Local:  http://localhost:3000
# Dev:    https://reserveit-dev.vercel.app  (or Vercel preview URL)
# Prod:   https://reserveit.vercel.app      (your actual domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ==============================================
# GOOGLE OAUTH (via Supabase)
# ==============================================
# Paste these into: Supabase Dashboard → Authentication → Providers → Google
# Get from: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==============================================
# AUTHENTICATION
# ==============================================
# JWT Secret (if using custom JWT logic beyond Supabase Auth)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_random_jwt_secret_here

# ==============================================
# PAYMENT INTEGRATION
# ==============================================
# PayMongo Keys - Get from: https://dashboard.paymongo.com/developers
PAYMONGO_SECRET_KEY=sk_test_your_secret_key
PAYMONGO_PUBLIC_KEY=pk_test_your_public_key

# ==============================================
# MICROSOFT 365 SSO
# ==============================================
# Azure AD Configuration - Get from: https://portal.azure.com > App registrations > ReserveIT
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret
AZURE_TENANT_ID=your_azure_tenant_id

# Optional profiles for the local tenant-switch commands
AZURE_STI_CLIENT_ID=your_sti_azure_client_id
AZURE_STI_CLIENT_SECRET=your_sti_azure_client_secret
AZURE_STI_TENANT_ID=your_sti_azure_tenant_id
AZURE_TEST_CLIENT_ID=your_test_azure_client_id
AZURE_TEST_CLIENT_SECRET=your_test_azure_client_secret
AZURE_TEST_TENANT_ID=your_test_azure_tenant_id

# AZURE_REDIRECT_URI=http://localhost:3000/api/auth/callback/azure

# ==============================================
# EMAIL NOTIFICATIONS (Microsoft Graph)
# ==============================================
# Sender address registered in the Azure app (M365 mailbox)
MAIL_SENDER_ADDRESS=noreply@yourdomain.onmicrosoft.com

# ACADEMIC_HEAD_EMAIL is intentionally not an env var.
# It is resolved dynamically from the user_roles table at send time.
# Use POST /api/user-manager/roles/academic-head/transfer to change recipients.

# ==============================================
# CRON JOBS
# ==============================================
# Secret token sent by Vercel Cron in the Authorization header
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your_cron_secret_here

# ==============================================
# LOGGING & MONITORING (Future Phase)
# ==============================================
# Sentry DSN - Get from: https://sentry.io
# SENTRY_DSN=your_sentry_dsn

# ==============================================
# NOTES
# ==============================================
# 1. Replace all "your_*" placeholders with actual values
# 2. For development, copy this to .env.local
# 3. For production, use your hosting provider's environment variable system
# 4. Verify .env.local is in .gitignore to prevent accidental commits

# ==============================================
# AI ASSISTANT (Optional)
# ==============================================
# Enable/disable AI booking assistant UI
NEXT_PUBLIC_AI_FEATURES_ENABLED=true

# OpenRouter API key (used when LOCAL_LLM_ENABLED=false)
# Get from: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key
NVIDIA_API_KEY=your_nvidia_api_key

# Local LLM fallback (optional)
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://localhost:11434

# ==============================================
# UPSTASH REDIS CACHE
# ==============================================
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
REDIS_URL=your_upstash_redis_url

